# Copy this file to .env and fill in values as needed.

# true = no external API calls, canned data used everywhere (great for
# demos, offline dev, and CI). false = real Groq + faster-whisper calls.
MOCK_MODE=false

# Required only when MOCK_MODE=false. Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# faster-whisper settings (only used when MOCK_MODE=false)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
